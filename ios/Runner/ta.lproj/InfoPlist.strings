"NSLocationAlwaysAndWhenInUseUsageDescription" = "வரைபடத் திரையில் காட்டவும், இடம் சார்ந்த சேவைகளை வழங்கவும் இந்த செயலிக்கு உங்கள் இருப்பிடத்தை அணுக அனுமதி தேவை.";
"NSLocationAlwaysUsageDescription" = "வரைபடத் திரையில் காட்டவும், இடம் சார்ந்த சேவைகளை வழங்கவும் இந்த செயலிக்கு உங்கள் இருப்பிடத்தை அணுக அனுமதி தேவை.";
"NSLocationWhenInUseUsageDescription" = "வரைபடத் திரையில் காட்டவும், இடம் சார்ந்த சேவைகளை வழங்கவும் இந்த செயலிக்கு உங்கள் இருப்பிடத்தை அணுக அனுமதி தேவை.";
"NSMicrophoneUsageDescription" = "குரல் செய்திகளை பதிவு செய்ய அனுமதிக்க மைக்ரோஃபோனை அணுக அனுமதி வேண்டுகிறோம்";
"NSPhotoLibraryAddUsageDescription" = "உங்கள் Photo Library-யில் படங்கள்/வீடியோக்களை சேமிக்க அனுமதி வேண்டுகிறோம்";
"NSPhotoLibraryUsageDescription" = "உங்கள் சுயவிவரப் படமாக பயன்படுத்த ஒரு புகைப்படத்தைத் தேர்ந்தெடுக்க இந்த செயலிக்கு உங்கள் புகைப்பட நூலகத்தை அணுக அனுமதி தேவை";
"NSSpeechRecognitionUsageDescription" = "இந்த பயன்பாட்டிற்கு speech recognition அனுமதி தேவை";
"NSUserTrackingUsageDescription" = "இந்த அடையாளம் உங்களுக்கு தனிப்பயனாக்கப்பட்ட விளம்பரங்களை வழங்க பயன்படுத்தப்படும். \"Ask App Not to track\" என்பதைத் தேர்ந்தெடுத்தால், தொடர்புடைய விளம்பரங்களை வழங்கும் Advertisement network-இன் திறன் குறையும்; ஆனால் நீங்கள் பெறும் விளம்பரங்களின் எண்ணிக்கை குறையாது.";
